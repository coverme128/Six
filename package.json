{
  "name": "six-professional-v2",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @six/web dev",
    "dev:admin": "pnpm --filter @six/admin dev",
    "dev:api": "pnpm --filter @six/api dev",
    "dev:worker": "pnpm --filter @six/worker dev",
    "start": "pnpm run dev:api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:domain": "pnpm --filter @six/domain build && node --import tsx --test tests/deterministic-engine.test.ts tests/report-and-ai.test.ts tests/calendar-provider.test.ts tests/core-v1-loader.test.ts tests/ai-report.test.ts tests/content-framework.test.ts tests/presentation.test.ts",
    "test:ai": "pnpm --filter @six/domain build && node --import tsx --test tests/ai-report.test.ts",
    "test:contract": "node --import tsx --test tests/api-contract.test.ts",
    "test:questions": "pnpm --filter @six/shared build && pnpm --filter @six/domain build && TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --import tsx --test apps/api/tests/question-understanding.node.ts",
    "test:workbench": "pnpm --filter @six/shared build && TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --import tsx --test apps/api/tests/workbench-safety.node.ts",
    "smoke:questions:live": "tsx scripts/ai/question-flow-smoke.ts",
    "test:home": "node --import tsx --test tests/home-example.test.ts",
    "test:experience": "pnpm --filter @six/domain build && node --import tsx --test tests/presentation.test.ts",
    "test:calendar": "pnpm --filter @six/domain build && node --import tsx --test tests/calendar-provider.test.ts",
    "fixtures:calendar": "pnpm --filter @six/domain build && tsx scripts/calendar/generate_cal_std_v1_fixtures.ts",
    "content:validate": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts validate",
    "content:dry-run": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts dry-run",
    "content:import": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts import",
    "content:index": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts index",
    "content:links": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts links",
    "content:seo": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts seo",
    "content:qa": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts qa",
    "content:test-assets": "node --import tsx --test tests/content-batch07-assets.test.ts",
    "content:rehearsal": "pnpm --filter @six/domain build && tsx scripts/content/manage.ts rehearsal",
    "content:finalize-local": "node scripts/content/finalize-local-release.mjs",
    "content:prepare-finalization": "node scripts/content/prepare-commercial-finalization.mjs",
    "content:import-articles": "tsx scripts/content/import-commercial-articles.ts",
    "content:import-knowledge": "tsx scripts/content/import-commercial-knowledge.ts",
    "content:import-faq": "tsx scripts/content/import-commercial-faq.ts",
    "content:import-closure": "tsx scripts/content/import-commercial-closure.ts",
    "content:export-snapshot": "tsx scripts/content/export-current-snapshot.ts",
    "smoke:ai:live": "pnpm --filter @six/domain build && tsx scripts/ai/live-smoke.ts",
    "validate:p1": "pnpm run fixtures:calendar && pnpm run validate",
    "validate:p2": "pnpm run validate:p1 && pnpm run test:e2e",
    "validate:p4-framework": "pnpm run validate && pnpm run content:rehearsal && pnpm run content:qa && pnpm run content:seo && pnpm run test:e2e",
    "validate:experience": "pnpm run test:experience && playwright test tests/e2e/experience.spec.ts",
    "validate:w1": "pnpm run validate && pnpm run test:e2e",
    "validate:v13": "python3 scripts/production/validate_v13_core.py",
    "validate:liuyao-interpretation-assets": "pnpm --filter @six/domain build && tsx scripts/liuyao/validate-interpretation-assets.ts",
    "audit:liuyao-product-closure": "pnpm --filter @six/domain build && tsx scripts/liuyao/audit-product-closure.ts",
    "validate:liuyao-product-closure": "pnpm run audit:liuyao-product-closure && pnpm run test:experience && pnpm run test:ai",
    "validate": "pnpm run validate:v13 && pnpm run typecheck && pnpm run test:domain && pnpm run test:contract",
    "db:generate": "PRISMA_ENGINES_CACHE_DIR=./.prisma-cache pnpm --filter @six/database db:generate",
    "db:migrate": "PRISMA_ENGINES_CACHE_DIR=./.prisma-cache pnpm --filter @six/database db:migrate",
    "db:seed": "pnpm --filter @six/database db:seed"
  },
  "dependencies": {
    "@six/domain": "workspace:*",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
