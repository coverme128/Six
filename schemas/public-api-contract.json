{
  "version": "workspace-cast-v2",
  "workspaceAuthentication": { "header": "x-six-workspace", "format": "64 lowercase hex characters (256 random bits)", "requiredFor": ["/api/v1/reports", "/api/v1/reports/*", "/api/v1/liuyao/questions/understand", "/api/v1/liuyao/charts"] },
  "castRequest": { "required": ["requestId", "question", "calendar.instantUtc", "calendar.timezone"], "exactlyOneOf": ["values", "coins"], "deferUnderstanding": "Explicitly save chart without AI classification; no AI answer is fabricated." },
  "routes": [
    { "method": "GET", "path": "/api/v1/health" },
    { "method": "GET", "path": "/api/v1/ready" },
    { "method": "GET", "path": "/api/v1/ai/status" },
    { "method": "POST", "path": "/api/v1/liuyao/questions/understand" },
    { "method": "GET", "path": "/api/v1/metadata" },
    { "method": "POST", "path": "/api/v1/liuyao/charts" },
    { "method": "POST", "path": "/api/v1/meihua/charts", "status": 410 },
    { "method": "POST", "path": "/api/v1/reports/demo", "status": 410 },
    { "method": "GET", "path": "/api/v1/reports" },
    { "method": "GET", "path": "/api/v1/reports/:id" },
    { "method": "GET", "path": "/api/v1/reports/:id/experience" },
    { "method": "GET", "path": "/api/v1/reports/:id/export" },
    { "method": "DELETE", "path": "/api/v1/reports" },
    { "method": "DELETE", "path": "/api/v1/reports/:id" },
    { "method": "POST", "path": "/api/v1/reports/:id/understanding" },
    { "method": "POST", "path": "/api/v1/reports/:id/ai" },
    { "method": "POST", "path": "/api/v1/reports/:id/ai/jobs" },
    { "method": "GET", "path": "/api/v1/content" },
    { "method": "GET", "path": "/api/v1/content/search" },
    { "method": "GET", "path": "/api/v1/content/:contentId/related" },
    { "method": "GET", "path": "/api/v1/content/:contentType/:slug" },
    { "method": "GET", "path": "/api/v1/knowledge" },
    { "method": "GET", "path": "/api/v1/knowledge/search" },
    { "method": "GET", "path": "/api/v1/knowledge/:slug" },
    { "method": "GET", "path": "/api/v1/hexagrams/:slug" },
    { "method": "GET", "path": "/api/v1/glossary/:slug" },
    { "method": "GET", "path": "/api/v1/blog/posts" },
    { "method": "GET", "path": "/api/v1/blog/posts/:slug" },
    { "method": "GET", "path": "/api/v1/settings" },
    { "method": "PUT", "path": "/api/v1/settings" }
  ],
  "errorShape": {
    "required": ["code", "message", "traceId"]
  }
}
