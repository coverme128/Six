  "exports": {
    "./ai-report": {
      "types": "./dist/domain/aiReport.d.ts",
      "import": "./dist/domain/aiReport.js"
    },
    "./calendar": {
      "types": "./dist/domain/calendar.d.ts",
      "import": "./dist/domain/calendar.js"
    },
    "./content-framework": {
      "types": "./dist/domain/contentFramework.d.ts",
      "import": "./dist/domain/contentFramework.js"
    },
    "./data-store": {
      "types": "./dist/domain/dataStore.d.ts",
      "import": "./dist/domain/dataStore.js"
    },
    "./knowledge": {
      "types": "./dist/domain/knowledge.d.ts",
      "import": "./dist/domain/knowledge.js"
    },
    "./liuyao": {
      "types": "./dist/domain/liuyaoEngine.d.ts",
      "import": "./dist/domain/liuyaoEngine.js"
    },
    "./meihua": {
      "types": "./dist/domain/meihuaEngine.d.ts",
      "import": "./dist/domain/meihuaEngine.js"
    },
    "./presentation": {
      "types": "./dist/domain/presentation/index.d.ts",
      "import": "./dist/domain/presentation/index.js"
    },
    "./production": {
      "types": "./dist/production/index.d.ts",
      "import": "./dist/production/index.js"
    },
    "./report-builder": {
      "types": "./dist/domain/reportBuilder.d.ts",
      "import": "./dist/domain/reportBuilder.js"
    }
