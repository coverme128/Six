  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --pass-on-no-patterns",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && cd ../.. && node --import tsx --test tests/deterministic-engine.test.ts tests/report-and-ai.test.ts tests/calendar-provider.test.ts tests/core-v1-loader.test.ts tests/ai-report.test.ts tests/content-framework.test.ts tests/presentation.test.ts"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7"
  }
